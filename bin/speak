#!/usr/bin/env python3
"""speak: speaks aloud each Claude Code reply, with Kokoro running locally (no network, no cost).

  speak on | off [all]     turn the voice on or off for this Claude Code session (the nearest ancestor process
                           named `claude`); `all` (or outside a session) acts on every session and the general switch
  speak status             show the version of the plugin (first line) and the state: effective here, general, this session, mode, engine, voice
  speak mode full|summary [all]  for this session (with `all`, or outside a session: the general mode and every
                           session); full: the whole reply without code, paths, links and file names;
                           summary (default): only its last line starting with 🔊 (rules/speak.md)
  speak size small|medium|large [all]  how long the spoken summary is (one short sentence; two or three sentences;
                           a paragraph); same scopes as `mode`; default medium
  speak mic wait|play|auto [all]  what the speech does while a program records from the microphone (dictation,
                           video call); same scopes as `mode`; wait (default): the speech waits and a recording that
                           starts cuts it; play: it plays anyway, until changed, and only Claude Code's own dictation (holding the
                           space bar; Linux) still holds and cuts it (the microphone may pick up the voice and the
                           people in the meeting hear it); auto: as play, and when the
                           microphone goes from busy to free (the meeting ends) the choice goes back to wait by itself,
                           in the scope where it was written
  speak update             update this plugin: `claude plugin marketplace update` and `claude plugin update` (120 s each);
                           prints the version before and after, in Portuguese; the new version holds after
                           /reload-plugins or in a new session
  speak status --json      the same state as one JSON line (used by the /speak pane)
  speak voice [name]       without a name: list the Portuguese voices (dora, alex, santa) and mark the current one;
                           with a name (short or full, e.g. dora or pf_dora): choose it for every session
  speak rule               print rules/speak.md with {line} replaced by the line of the mode and size in force
                           (the SessionStart hook hands it to Claude)
  speak check              print `engine` and/or `player` for what is missing; exit 0 when nothing is
                           (on stderr, a line "processos acima: pid nome, ...": the ancestors, to find the session)
  speak test [text]        speak a test sentence, in the foreground (errors show)
  speak install            install the engine: Python 3.12 via uv, kokoro-onnx (on the Mac also sounddevice, optional),
                           model files (~350 MB); no sudo
  speak autoinstall        start `speak install` in the background unless it is running, failed already in this plugin
                           version, the uv is missing or CLAUDE_SPEAK_AUTOINSTALL=0; prints one word: ready (engine
                           there), installing, no-uv, failed or off (plus `started` after installing when this call
                           started it); exit 0 (used by hooks/speak-start.py and by the
                           /speak module when the plugin is turned on in the middle of a session)
  speak say [text | -]     speak in the background and return at once; `-` reads the reply from stdin and applies
                           the mode (used by hooks/speak-stop.py)
  speak stop               cut the speech playing now, whoever's it is, and drop every speech waiting its turn; the
                           voice stays on
  speak stop here          cut only the speeches of this session (playing or waiting); other sessions' speeches stay
                           (used by hooks/speak-end.py when the session ends)
  speak again [summary|full]  speak the last reply of this session again, even with the voice off: as it played
                           (no word), only its 🔊 line (`summary`; the whole reply when it had none) or the whole
                           reply (`full`); `speak say -` keeps the last reply of each session for this
  speak told [full|summary] print, or record, the mode last told to the model in this session (`rule` records it;
                           used by hooks/speak-cut.py to say when the mode changes)
  speak silent             exit 0 when this session will not speak, else 1; when it will not, prints why: `off` (voice
                           off here), `installing [percent]` (engine being installed) or `missing` (no engine, no
                           install running); used by hooks/speak-cut.py to tell Claude to leave out the 🔊 line

The speech starts after its first short piece is ready and goes on while the rest is synthesized. A new speech, from
any session, never cuts the one playing: it waits its turn in a queue (arrival order, one at a time, and only while no
program is recording from the microphone, unless `speak mic play|auto`). Only a recording that starts meanwhile cuts the speech playing (holding
the space bar to dictate in Claude Code does), seen through pw-dump on Linux and through CoreAudio on the Mac; the
speeches waiting are kept and go on when the microphone is free. `speak off` in a session also drops that session's speeches (playing or waiting).
Env: CLAUDE_SPEAK=0 silences one session (a first choice that a later `speak on` beats);
CLAUDE_SPEAK_SESSION forces the session key ('-' means none; for tests and to force a key);
CLAUDE_SPEAK_MODE overrides the mode; CLAUDE_SPEAK_SIZE the size; CLAUDE_SPEAK_MIC the microphone choice; CLAUDE_SPEAK_VOICE the voice (default pf_dora);
CLAUDE_SPEAK_SPEED (default 1.1).
Files live in the plugin's data folder (CLAUDE_PLUGIN_DATA or CLAUDE_SPEAK_DATA; see lib/speak_paths.py): engine/, config/, state/.
Errors of a background speech go to state/error.log there.
"""
import fcntl
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))  # python3 -I does not add it
import speak_os  # noqa: E402
import speak_paths  # noqa: E402
import speak_update  # noqa: E402

HOME = os.path.expanduser('~')
DATA, CONF, STATE = speak_paths.paths(os.path.realpath(__file__))  # engine, choices, state: see lib/speak_paths.py
OFF_FLAG = os.path.join(CONF, 'off')
ALL_MARK = os.path.join(STATE, 'all')  # its modification time: when the last request for every session was made
SESSIONS = os.path.join(STATE, 'sessions')  # one file per session: name = key, content = JSON
LAST = os.path.join(STATE, 'last')  # one file per session: the last raw reply and the mode it was read in (JSON)
MODE_FILE = os.path.join(CONF, 'mode')
MODES = ('full', 'summary')
SIZE_FILE = os.path.join(CONF, 'size')
SIZES = ('small', 'medium', 'large')
MIC_FILE = os.path.join(CONF, 'mic')
MICS = ('wait', 'play', 'auto')
MIC_TEXT = {'wait': 'espera', 'play': 'toca', 'auto': 'toca nesta reunião'}
MIC_SEEN = os.path.join(STATE, 'mic-seen')  # `auto` in the general setting: a busy microphone was seen under it
RULE_LINE = {  # the first bullet of rules/speak.md, by the mode in force
    'summary': 'While the voice is on, every reply to the human ends with that `\U0001f50a` line, in plain Brazilian '
               'Portuguese: {size}. The full reading skips it. Only in replies to the human: never in the recap '
               '(away summary, "while you were away") nor in titles or other text Claude Code writes on its own.',
    'full': 'The voice reads the whole reply (`speak mode full`) and skips the `\U0001f50a` line, so in this mode '
            'do not write it: the new-message hook says so in a `speak:` note.'}
SIZE_TEXT = {'small': 'one short sentence',
             'medium': 'two or three sentences: what was done, the result and what the human must decide',
             'large': 'a spoken paragraph of four to six sentences: what was done, what was found, the result and '
                      'what the human must decide'}
VOICE_FILE = os.path.join(CONF, 'voice')
PT_VOICES = {'dora': ('pf_dora', 'feminina'), 'alex': ('pm_alex', 'masculina'), 'santa': ('pm_santa', 'masculina')}
RULE = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'rules', 'speak.md')
VENV_PY = os.path.join(DATA, '.venv', 'bin', 'python')
MODEL = os.path.join(DATA, 'kokoro-v1.0.onnx')
VOICES = os.path.join(DATA, 'voices-v1.0.bin')
MODEL_URL = 'https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/'
PID = os.path.join(STATE, 'speech.pid')
OWNER = os.path.join(STATE, 'speech.owner')  # key of the session that owns the speech playing ('' = none)
LOCK = os.path.join(STATE, 'queue.lock')  # flock'ed while a speech joins the queue or takes its turn
QUEUE = os.path.join(STATE, 'queue')  # one ticket per speech waiting: name '<time_ns>-<pid>', content = session key
LOG = os.path.join(STATE, 'error.log')
RATE = speak_os.RATE  # Kokoro's output, mono float32
MARK = '🔊'
LIMIT = {'full': 6000}  # characters; a longer reply is cut at a sentence end
SUMMARY_LIMIT = {'small': 300, 'medium': 600, 'large': 1200}  # the same, for the 🔊 line, by size
PIECES = (120, 160, 220, 300, 400)  # characters per piece: short first, then growing, so each is ready while the last plays
MIC_POLL = 0.15  # seconds between looks at the microphone while speaking
QUEUE_POLL = 0.15  # seconds between looks at the queue while waiting a turn


def voice():
    """CLAUDE_SPEAK_VOICE, then the general file, then pf_dora."""
    wanted = os.environ.get('CLAUDE_SPEAK_VOICE')
    if not wanted:
        try:
            with open(VOICE_FILE) as fh:
                wanted = fh.read().strip()
        except OSError:
            pass
    return wanted or 'pf_dora'


def voice_name(wanted):
    """Full name of a Portuguese voice from its short or full name; None if unknown."""
    wanted = wanted.strip().lower()
    for short, (full, _) in PT_VOICES.items():
        if wanted in (short, full):
            return full
    return None


def speed():
    try:
        return float(os.environ.get('CLAUDE_SPEAK_SPEED') or 1.1)
    except ValueError:
        return 1.1


def mode(session=None):
    """CLAUDE_SPEAK_MODE, then the session's own mode, then the general file, then 'summary'."""
    wanted = os.environ.get('CLAUDE_SPEAK_MODE') or session_mode(session)
    if not wanted:
        try:
            with open(MODE_FILE) as fh:
                wanted = fh.read().strip()
        except OSError:
            pass
    return wanted if wanted in MODES else 'summary'


def summary_size(session=None):
    """CLAUDE_SPEAK_SIZE, then the session's own size, then the general file, then 'medium'."""
    wanted = os.environ.get('CLAUDE_SPEAK_SIZE') or read_session(session).get('size')
    if not wanted:
        try:
            with open(SIZE_FILE) as fh:
                wanted = fh.read().strip()
        except OSError:
            pass
    return wanted if wanted in SIZES else 'medium'


def mic(session=None):
    """CLAUDE_SPEAK_MIC, then the session's own choice, then the general file, then 'wait'."""
    wanted = os.environ.get('CLAUDE_SPEAK_MIC') or read_session(session).get('mic')
    if not wanted:
        try:
            with open(MIC_FILE) as fh:
                wanted = fh.read().strip()
        except OSError:
            pass
    return wanted if wanted in MICS else 'wait'


def session_key(pid):
    """'<pid>-<start time>' of a process, which tells it from a later process that reuses the number; None if unreadable."""
    start = speak_os.started(pid)
    return '%d-%s' % (pid, start) if start is not None else None


def current_session():
    """Key of the Claude Code session this process runs in: its nearest ancestor named `claude`; failing that, the
    nearest one with an argument whose base name is `claude` (a node install); None if none or unreadable."""
    forced = os.environ.get('CLAUDE_SPEAK_SESSION')
    if forced:
        return forced if forced != '-' and re.fullmatch(r'[A-Za-z0-9_-]+', forced) else None
    chain = []
    pid = os.getppid()
    while pid and pid > 1 and len(chain) < 64:
        found = speak_os.node(pid)  # (parent, name) in one read
        if found is None:
            break
        if found[1] == 'claude':
            return session_key(pid)
        chain.append(pid)
        pid = found[0]
    for pid in chain:
        if any(os.path.basename(arg) == 'claude' for arg in speak_os.argv(pid) or []):
            return session_key(pid)
    return None


def session_started(key):
    """Start time (seconds since the epoch) of the process of a '<pid>-<start>' key, computed from the key alone;
    None if it cannot be read."""
    try:
        pid, start = key.split('-')
        return speak_os.start_epoch(start) if int(pid) > 0 else None
    except ValueError:
        return None


def mark_all():
    write_atomic(ALL_MARK, '')


def prune_tmp():
    """Removes `.tmp-<pid>-*` leftovers in the state folder whose pid no longer exists (a killed writer)."""
    try:
        names = os.listdir(STATE)
    except OSError:
        return
    for name in names:
        match = re.fullmatch(r'\.tmp-(\d+)-.*', name)
        if match and not speak_os.alive(int(match.group(1))):
            try:
                os.remove(os.path.join(STATE, name))
            except OSError:
                pass


def write_atomic(path, text):
    """Writes through a temporary file in the state folder (same filesystem), then swaps it in."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    os.makedirs(STATE, exist_ok=True)
    prune_tmp()
    tmp = os.path.join(STATE, '.tmp-%d-%s' % (os.getpid(), os.urandom(4).hex()))
    try:
        with open(tmp, 'w') as fh:
            fh.write(text)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def session_alive(key):
    try:
        return session_key(int(key.split('-')[0])) == key
    except ValueError:
        return False


def read_session(key):
    """The fields of a session file: {'voice': 'muted'|'speaking', 'mode': 'full'|'summary', 'size': 'small'|'medium'|'large'}, each optional.
    A bare `muted` or `speaking` (a file of the first format) counts as the voice."""
    if not key:
        return {}
    try:
        with open(os.path.join(SESSIONS, key)) as fh:
            raw = fh.read().strip()
    except (OSError, ValueError):
        return {}
    try:
        data = json.loads(raw)
    except ValueError:
        data = {'voice': raw}
    if not isinstance(data, dict):
        return {}
    return {k: v for k, v in data.items() if (k == 'voice' and v in ('muted', 'speaking'))
            or (k == 'mode' and v in MODES) or (k == 'size' and v in SIZES)
            or (k == 'told' and v in MODES) or (k == 'mic' and v in MICS) or (k == 'micseen' and v is True)}


def session_mode(key):
    """'full', 'summary' or None (follows the general mode)."""
    return read_session(key).get('mode')


def session_choice(key):
    """'muted', 'speaking' or None (follows the general switch).
    CLAUDE_SPEAK=0 seeds a session once, when it has no file."""
    if not key:
        return None
    choice = read_session(key).get('voice')
    if choice:
        return choice
    if os.environ.get('CLAUDE_SPEAK') == '0' and not asked_after_start(key):
        try:
            set_session(key, voice='muted')
        except OSError:
            pass
        return 'muted'
    return None


def asked_after_start(key):
    """True when a request for every session came after this session opened (it beats the CLAUDE_SPEAK=0 seed)."""
    started = session_started(key)
    try:
        return started is not None and os.stat(ALL_MARK).st_mtime >= started
    except OSError:
        return False


def set_session(key, **fields):
    """Updates only the given fields (voice=, mode=, size=, mic=) of a session file, keeping the others; a field
    given as None is removed."""
    os.makedirs(SESSIONS, exist_ok=True)
    prune_sessions()
    merged = {**read_session(key), **fields}
    write_atomic(os.path.join(SESSIONS, key), json.dumps({k: v for k, v in merged.items() if v is not None}))


def clear_all_sessions(*fields):
    """Removes the given fields (voice, mode, size, mic) from every session file, keeping the file (even empty):
    an empty file means the session follows the general setting in everything."""
    prune_sessions()
    for key in os.listdir(SESSIONS) if os.path.isdir(SESSIONS) else ():
        data = read_session(key)
        if any(f in data for f in fields):
            write_atomic(os.path.join(SESSIONS, key), json.dumps({k: v for k, v in data.items() if k not in fields}))


def own_field(session, field):
    """True when the session's file holds its own value for the field (an exception to the general setting)."""
    return bool(session) and field in read_session(session)


def prune_sessions():
    for folder in (SESSIONS, LAST):
        for key in os.listdir(folder) if os.path.isdir(folder) else ():
            if not session_alive(key):
                try:
                    os.remove(os.path.join(folder, key))
                except OSError:
                    pass


def save_last(session, message, how):
    """Keeps the last raw reply of the session and the mode it was read in (only the last; atomic write)."""
    if not session or not message.strip():
        return
    try:
        prune_sessions()
        write_atomic(os.path.join(LAST, session), json.dumps({'message': message, 'mode': how}))
    except OSError:
        pass


def read_last(session):
    """(message, mode) of the session's last reply; None when there is none."""
    if not session:
        return None
    try:
        with open(os.path.join(LAST, session)) as fh:
            data = json.load(fh)
        message, how = data['message'], data['mode']
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return (message, how) if isinstance(message, str) and message.strip() and how in MODES else None


def is_on(session=None):
    choice = session_choice(session)
    if choice:
        return choice == 'speaking'
    if not session and os.environ.get('CLAUDE_SPEAK', '1') == '0':
        return False
    return not os.path.exists(OFF_FLAG)


def engine_ready():
    return all(os.path.exists(p) for p in (VENV_PY, MODEL, VOICES))


# --- what is spoken -----------------------------------------------------------------------------------------------

VERSION = r'v?(\d+(?:\.\d+){1,3})'  # two to four numbers separated by dots, an optional v before


def _version_spoken(match):
    """0.9.1 -> "0 ponto 9 ponto 1": spelled so the voice reads neither a date nor a decimal number."""
    return match.group(1).replace('.', ' ponto ')


def _inline_code(match):
    """Keeps `speak off` (plain words) and `0.9.1` (read as "0 ponto 9 ponto 1"); drops `ci-mac`, `e863ea0`,
    `~/.claude/x`, `CLAUDE_SPEAK=0` and the like."""
    inner = match.group(1).strip()
    if re.fullmatch(VERSION, inner):
        return re.sub(VERSION, _version_spoken, inner)
    word = r"[^\W\d_]+(?:'[^\W\d_]+)*"
    return inner if len(inner) <= 40 and re.fullmatch(word + '(?: ' + word + ')*', inner) else ''


def _slash_name(name):
    return 'barra ' + name.replace('-', ' ')


def _slash_in_code(match):
    """`/speak stop` -> "barra speak stop": a slash command between backticks, its simple words kept and the rest
    (arguments such as speak@cc-speaker) dropped; anything else between backticks is left to `_inline_code`."""
    found = re.fullmatch(r'\s*/([A-Za-z][A-Za-z0-9-]*)((?:\s+[^\W\d_]+(?=\s|$))*)(?:\s+\S.*)?\s*', match.group(1))
    if not found:
        return match.group(0)
    return (_slash_name(found.group(1)) + found.group(2)).strip()


def clean(text):
    """One line of markdown made fit to be heard. A slash command (`/speak stop`, `/reload-plugins`) is read as
    "barra speak stop"; paths are dropped."""
    text = re.sub(r'^\s*(?:>\s*)*(?:#{1,6}\s+|[-*+]\s+|\d+[.)]\s+)?', '', text)
    text = re.sub(r'!?\[([^\]]*)\]\([^)]*\)', r'\1', text)  # [label](url) -> label
    text = re.sub(r'`([^`]*)`', _slash_in_code, text)
    text = re.sub(r'`([^`]*)`', _inline_code, text)
    text = re.sub(r'https?://\S+', '', text)
    text = re.sub(r'(?<![\w-])(?=[0-9a-fA-F]*\d)(?=[0-9a-fA-F]*[a-fA-F])[0-9a-fA-F]{7,40}(?![\w-])', '', text)  # commit code
    text = re.sub(r'(?<![\w.-])' + VERSION + r'(?![\w-]|\.\d)', _version_spoken, text)  # 0.9.1, v2.1.312
    text = re.sub(r'\bHEAD\b', '', text)
    text = text.replace('·', ', ')
    text = re.sub(r'(?i)\b(ramos?|branch|worktree)\s+(?=[\w./-]*[-_\d/])[\w/-]+(?:\.[\w/-]+)*', r'\1', text)  # branch name
    text = re.sub(r'(?<![\w-])(?=[a-z0-9-]*[a-z])(?=[a-z0-9-]*\d)[a-z0-9]+(?:-[a-z0-9]+)+(?![\w-])', '', text)  # wt-1
    text = re.sub(r'(?<![\w/~.:-])/([A-Za-z][A-Za-z0-9-]*)(?![\w/-])(?!\.\w)',
                  lambda m: _slash_name(m.group(1)), text)  # a bare /command, before the path rule
    text = re.sub(r'(?<![\w/])[~.]{0,2}/[^\s,;)]+', '', text)  # /abs, ~/x, ./x, ../x
    text = re.sub(r'\b[\w.-]+/[\w./-]+', '', text)  # dir/file
    text = re.sub(r'\b[\w-]+\.(?:py|sh|json|jsonl|md|js|ts|tsx|txt|log|wav|onnx|bin|yml|yaml|toml|html|css)\b', '', text)
    text = text.replace('→', ', ').replace('->', ', ')
    text = re.sub(r'[*_`#|~<>]', '', text)
    text = re.sub(r'\(\s*[,;:]?\s*\)', '', text)
    text = re.sub(r'\s+([,;:.!?])', r'\1', text)
    text = re.sub(r'([,;:])(?:\s*[,;:])+', r'\1', text)
    return re.sub(r'\s+', ' ', text).strip(' ,;:-—')


def spoken_line(message):
    """summary: the text after the last 🔊 line; '' when there is none."""
    for line in reversed((message or '').splitlines()):
        line = line.strip().lstrip('>*_ ').strip()
        if line.startswith(MARK):
            return clean(line[len(MARK):])
    return ''


def full_text(message):
    """full: every line of prose and tables; code blocks, table rulers and the 🔊 line go."""
    out, fence = [], None
    for line in (message or '').splitlines():
        bare = line.strip()
        opening = re.match(r'(`{3,}|~{3,})', bare)
        if fence:
            if opening and bare.startswith(fence):
                fence = None
            continue
        if opening:
            fence = opening.group(1)
            continue
        if bare.lstrip('>*_ ').startswith(MARK) or re.fullmatch(r'\|?[\s:|-]*-[\s:|-]*\|?', bare):
            continue
        if bare.startswith('|'):
            said = ', '.join(c for c in (clean(cell) for cell in bare.strip('|').split('|')) if c)
        else:
            said = clean(bare)
        if re.search(r'\w', said):
            out.append(said if said[-1] in '.!?:;,' else said + '.')
    return ' '.join(out)


def to_speak(message, how=None, size=None):
    how = how or mode()
    text = spoken_line(message) if how == 'summary' else full_text(message)
    limit = SUMMARY_LIMIT[size or summary_size()] if how == 'summary' else LIMIT['full']
    if len(text) > limit:
        cut = max(text.rfind(p, 0, limit) for p in '.!?')
        text = text[:cut + 1 if cut > 0 else limit]
    return text


def pieces(text):
    """Sentences grouped into pieces whose size grows along PIECES (the last size repeats)."""
    out, cur = [], ''
    for sentence in re.split(r'(?<=[.!?;:])\s+', text):
        cap = PIECES[min(len(out), len(PIECES) - 1)]
        if cur and len(cur) + len(sentence) + 1 > cap:
            out.append(cur)
            cur = sentence
        else:
            cur = (cur + ' ' + sentence).strip()
    if cur:
        out.append(cur)
    return out


def synthesize_ahead(texts, synth, ahead=2):
    """Yields synth(text) for each text, in order, synthesizing up to `ahead` pieces in a background thread while
    the caller plays the current one (synthesis runs 1.4 to 1.9 times faster than speech, barely so on the first
    piece, so the pieces grow gradually and each is ready when the one before ends). An error of synth is raised
    to the caller; closing the generator stops the thread."""
    import queue
    import threading
    done, stop = object(), threading.Event()
    box = queue.Queue(maxsize=ahead)

    def put(item):
        while not stop.is_set():
            try:
                box.put(item, timeout=0.1)
                return True
            except queue.Full:
                continue
        return False

    def work():
        try:
            for text in texts:
                if stop.is_set() or not put(('ok', synth(text))):
                    return
        except Exception as exc:  # handed to the caller, which raises it
            put(('error', exc))
            return
        put(('ok', done))

    threading.Thread(target=work, daemon=True).start()
    try:
        while True:
            kind, value = box.get()
            if kind == 'error':
                raise value
            if value is done:
                return
            yield value
    finally:
        stop.set()


# --- speaking -----------------------------------------------------------------------------------------------------

def is_speech(pid):
    """True if `pid` is a speech process of ours: its command line is `<python> -I <...>/speak _play ...`.
    Known limit: on Mac the command line is split on spaces, so a plugin path with a space is not recognised
    (stop then leaves that speech playing)."""
    argv = speak_os.argv(pid)
    return bool(argv) and len(argv) > 3 and argv[1] == '-I' and os.path.basename(argv[2]) == 'speak' and argv[3] == '_play'


def clear_speech(pid):
    """Removes the speech files, only if PID still holds `pid` (a newer speech keeps its own)."""
    try:
        with open(PID) as fh:
            if int(fh.read().strip()) != pid:
                return
    except (OSError, ValueError):
        return
    for path in (PID, OWNER):
        try:
            os.remove(path)
        except OSError:
            pass


def terminate(pid):
    """SIGTERM to the process group of `pid` (a speech leads its own, with its player); to the process alone if not."""
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    except OSError:
        pass


def drop(path):
    try:
        os.remove(path)
    except OSError:
        pass


def tickets():
    """The queue as [(path, pid, key)], in arrival order. The ticket of a process that died or is no longer a speech
    is dropped on the way (this process counts as alive)."""
    try:
        names = os.listdir(QUEUE)
    except OSError:
        return []
    found = []
    for name in names:
        match = re.fullmatch(r'(\d+)-(\d+)', name)
        if not match:
            continue
        path = os.path.join(QUEUE, name)
        pid = int(match.group(2))
        # The own process is exempt: a single-process test registers and waits in the same process, which
        # is_speech() would not recognise as a speech.
        if pid != os.getpid() and not is_speech(pid):
            drop(path)
            continue
        try:
            with open(path) as fh:
                key = fh.read().strip()
        except OSError:
            continue
        found.append((int(match.group(1)), path, pid, key))
    return [(path, pid, key) for _, path, pid, key in sorted(found)]


def playing():
    """Pid of the speech playing now (other than this process); None if none."""
    try:
        with open(PID) as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        return None
    return pid if pid > 1 and pid != os.getpid() and is_speech(pid) else None


def stop_waiting(session=None):
    """Ends the speeches waiting their turn and drops their tickets: all of them, or only those of `session`."""
    for path, pid, key in tickets():
        if session is None or key == session:
            if pid != os.getpid():
                terminate(pid)
            drop(path)


def stop_playing():
    """Ends the speech playing (its whole process group, player included), if the pid is still a speech."""
    try:
        with open(PID) as fh:
            pid = int(fh.read().strip())
        if pid > 1 and is_speech(pid):
            terminate(pid)
            clear_speech(pid)
    except (OSError, ValueError):
        pass


def stop_current():
    """Ends every speech: the waiting ones first (so none takes the turn), then the one playing."""
    stop_waiting()
    stop_playing()


def stop_if_mine(session):
    """Ends the speeches of this session: the waiting ones, and the one playing if it owns it. A session of None
    owns nothing. Owner and pid are read and the cut is signalled under the queue lock, where `wait_turn` swaps both,
    so a speech that took over meanwhile is never mistaken for the old owner's (the signal does not wait for the
    process to die, so the lock is held only a moment)."""
    if not session:
        return
    stop_waiting(session)
    with queue_lock():
        try:
            with open(OWNER) as fh:
                owner = fh.read().strip()
            with open(PID) as fh:
                pid = int(fh.read().strip())
        except (OSError, ValueError):
            return
        if owner == session and pid > 1 and is_speech(pid):
            terminate(pid)
            clear_speech(pid)


def speak_background(text, session, force=False):
    """Speaks `text` for `session`, in order of arrival: the speech process joins the queue and waits its turn
    (it never cuts the speech playing). A muted session does not speak, unless `force` (an explicit request)."""
    if not text.strip() or not (force or is_on(session)) or not engine_ready():
        return 0
    os.makedirs(STATE, exist_ok=True)
    with open(LOG, 'a') as log:
        subprocess.Popen([VENV_PY, '-I', os.path.realpath(__file__), '_play', text],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log,
                         start_new_session=True, env={**os.environ, 'CLAUDE_SPEAK_SESSION': session or '-',
                                     **({'CLAUDE_SPEAK_AGAIN': '1'} if force else {})})
    return 0


def queue_lock():
    """Context manager: an exclusive lock on LOCK, so that joining the queue and taking the turn are never interleaved
    between speech processes (the kernel frees it if the holder dies)."""
    import contextlib
    import fcntl

    @contextlib.contextmanager
    def locked():
        os.makedirs(STATE, exist_ok=True)
        with open(LOCK, 'a') as fh:
            fcntl.flock(fh, fcntl.LOCK_EX)
            yield
    return locked()


def wait_turn(session, watch):
    """Joins the queue and waits to be the first that can play, with no speech playing; then takes the turn (writes
    speech.pid and speech.owner, drops the ticket). A speech whose session waits for a busy microphone does not
    count as first: the ones behind it may go. False if the ticket was dropped meanwhile (stopped).
    The ticket's name is taken and written, and the turn checked and taken, each under the queue lock."""
    import time
    with queue_lock():
        ticket = os.path.join(QUEUE, '%d-%d' % (time.time_ns(), os.getpid()))
        write_atomic(ticket, session or '-')
    while True:
        recs = current_recordings() if watch else None  # the microphone is read once per lap, for every ticket
        if watch:
            track_mic(session, recs)
        if not (watch and holds_with(session, recs)):
            with queue_lock():
                line = tickets()
                if not any(path == ticket for path, _, _ in line):
                    return False
                # The turn goes to the oldest speech that can play now: one whose session holds for the microphone
                # keeps its place but does not stop those behind it.
                head = next((path for path, _, key in line
                             if not (watch and ticket_holds(key, recs))), None)
                if head == ticket and playing() is None:
                    write_atomic(PID, str(os.getpid()))
                    write_atomic(OWNER, session or '')
                    drop(ticket)
                    return True
        elif not any(path == ticket for path, _, _ in tickets()):
            return False
        time.sleep(QUEUE_POLL)


def drop_own_tickets():
    try:
        names = os.listdir(QUEUE)
    except OSError:
        return
    for name in names:
        if re.fullmatch(r'\d+-%d' % os.getpid(), name):
            drop(os.path.join(QUEUE, name))


recordings = speak_os.recordings


def current_recordings():
    """What is recording from a microphone now (a set, empty when nothing); None when it cannot be read."""
    return speak_os.recordings_now()


def cut_by_microphone(player):
    """Ends the player and this speech process, leaving no speech files behind."""
    player.kill()
    clear_speech(os.getpid())
    os._exit(0)


def mic_busy(recs):
    """True only when there is at least one recording going on (`recs` is None when it could not be read)."""
    return bool(recs)


def dictating(recs):
    """True when Claude Code's own dictation (holding the space bar) is among the recordings (Linux only: the Mac
    cannot tell who records)."""
    return bool(getattr(recs, 'dictation', None))


def meeting_busy(recs):
    """True when something other than Claude Code's dictation is recording: dictating is not a meeting."""
    return bool(recs) and bool(set(recs) - set(getattr(recs, 'dictation', ())))


def track_mic(session, recs):
    """The `auto` choice: seeing the microphone busy is written down (in the session file when the choice is the
    session's own, else in STATE/mic-seen); seeing it free after that sends the choice back to `wait`, in that same
    scope. Nothing happens for another choice, when the microphone could not be read (`recs` is None) or when
    CLAUDE_SPEAK_MIC decides. Never raises: it also runs in the watcher thread."""
    try:
        if recs is None or os.environ.get('CLAUDE_SPEAK_MIC') or mic(session) != 'auto':
            return
        own = own_field(session, 'mic')
        seen = read_session(session).get('micseen', False) if own else os.path.exists(MIC_SEEN)
        if meeting_busy(recs) and not seen:
            if own:
                set_session(session, micseen=True)
            else:
                write_atomic(MIC_SEEN, '')
        elif not meeting_busy(recs) and seen:
            if own:
                set_session(session, mic='wait', micseen=None)
            else:
                write_atomic(MIC_FILE, 'wait\n')
                os.remove(MIC_SEEN)
    except OSError:
        pass


def holds_with(session, recs):
    """True when the speech of `session` must hold (`recs`, already read): with `wait`, any recording; with `play` or
    `auto`, only Claude Code's own dictation (the meeting does not hold)."""
    return mic_busy(recs) if mic(session) == 'wait' else dictating(recs)


def ticket_holds(key, recs):
    """True when the speech behind a ticket (its session key as written there) holds for the microphone (see
    `holds_with`). A ticket from an old version has no session: it counts as `wait`. A '-' is a speech with no session (general choice)."""
    if not key:
        return mic_busy(recs)
    return holds_with(None if key == '-' else key, recs)


def holds_for_microphone(session):
    """True when a speech must wait (or be cut): with `wait` any recording; with `play` or `auto` only the dictation of
    Claude Code. On the Mac `play` does not even look at the microphone (nothing could hold); with `auto` it is looked
    at to see when the meeting ends."""
    if mic(session) == 'play' and speak_os.SYSTEM == 'mac':
        return False
    recs = current_recordings()
    track_mic(session, recs)
    return holds_with(session, recs)


def watch_microphone(player, session=None):
    """Ends this speech (the player, then this process) as soon as any recording is going on, unless the microphone
    choice of the session lets the speech play. Returns (stop, thread): the caller sets `stop` and joins the thread
    when the speech ends, so no watcher outlives its speech."""
    import threading

    stop = threading.Event()

    def loop():
        while not stop.wait(MIC_POLL):
            if holds_for_microphone(session):
                cut_by_microphone(player)
                return

    thread = threading.Thread(target=loop, daemon=True)
    thread.start()
    return stop, thread


def stop_watching(watcher):
    """Ends the watcher `watch_microphone` returned (None: there is none) and waits a moment for it."""
    if watcher:
        stop, thread = watcher
        stop.set()
        thread.join(1)


class FilePlayer:
    """The player of a system that plays files (Mac): one `afplay <wav>` per piece. `kill()` stops the one in
    progress and removes its file, so the microphone cut leaves nothing behind."""

    def __init__(self, command):
        self.command = command
        self.proc = None
        self.path = None
        self.lock = threading.Lock()

    def play(self, samples):
        import soundfile
        path = os.path.join(STATE, '.tmp-%d-%s.wav' % (os.getpid(), os.urandom(4).hex()))  # prune_tmp sweeps strays
        try:
            soundfile.write(path, samples, RATE)
            with self.lock:
                self.path = path
                self.proc = subprocess.Popen(self.command + [path])
            return self.proc.wait()
        finally:
            self.discard()

    def discard(self):
        with self.lock:
            path, self.path = self.path, None
        if path:
            try:
                os.remove(path)
            except OSError:
                pass

    def kill(self):
        with self.lock:
            proc = self.proc
        if proc is not None:
            proc.kill()
        self.discard()


STREAM_SLACK = 2.0  # seconds a stream write or stop may take beyond the audio's own length before it is given up on
STREAM_OPEN = 5.0  # seconds to open and start the output stream (a device that never answers must not hold the speech)


class StreamPlayer:
    """Plays through one sounddevice output stream at the synthesis rate (Mac). Raises on anything that goes wrong
    (import, device query or open, write, or a write that takes longer than the piece plus STREAM_SLACK: a device
    that vanished, such as a Bluetooth headset, may never answer); the caller falls back to files. Changes no
    system audio setting."""

    def __init__(self):
        import sounddevice
        self.closed = False
        self.lock = threading.Lock()
        self.stream = None
        found, gate, late = [], threading.Lock(), threading.Event()

        def opening():
            stream = None
            try:
                stream = sounddevice.OutputStream(samplerate=RATE, channels=1, dtype='float32')
                stream.start()
            except BaseException as exc:
                if stream is not None:
                    try:
                        stream.close()
                    except Exception:
                        pass
                with gate:
                    found.append(exc)
                return
            with gate:
                found.append(stream)
                abandoned = late.is_set()
            if abandoned:  # opened after the deadline: nobody wants it any more, and it must not hold the device
                try:
                    stream.abort()
                except Exception:
                    pass
                try:
                    stream.close()
                except Exception:
                    pass

        thread = threading.Thread(target=opening, daemon=True)
        thread.start()
        thread.join(STREAM_OPEN)
        with gate:
            if not found:
                late.set()
                raise TimeoutError('the audio stream did not open in %.1f s' % STREAM_OPEN)
        if isinstance(found[0], BaseException):
            self.closed = True
            raise found[0]
        self.stream = found[0]

    def bounded(self, call, seconds):
        """Runs call() in a daemon thread and waits `seconds` for it; its error is raised here. On timeout the
        stream is aborted without waiting (that may hang too) and TimeoutError is raised."""
        box = []

        def work():
            try:
                call()
                box.append(None)
            except BaseException as exc:
                box.append(exc)

        thread = threading.Thread(target=work, daemon=True)
        thread.start()
        thread.join(seconds)
        if not box:
            self.abort(wait=False)
            raise TimeoutError('the audio stream did not answer in %.1f s' % seconds)
        if box[0] is not None:
            raise box[0]

    def play(self, samples):
        data = samples.astype('float32').reshape(-1, 1)
        self.bounded(lambda: self.stream.write(data), len(samples) / RATE + STREAM_SLACK)
        return 0

    def finish(self):
        """After the last piece: lets what was written play out (for a limited time), then closes."""
        try:
            self.bounded(self.stream.stop, STREAM_SLACK)
        except TimeoutError:
            pass
        finally:
            self.close()

    def close(self):
        with self.lock:
            if self.closed:
                return
            self.closed = True
        try:
            self.stream.close()
        except Exception:
            pass

    def abort(self, wait=True):
        """Aborts and closes the stream; with wait=False in a daemon thread (the call may never return)."""
        def work():
            if self.closed:
                return
            try:
                self.stream.abort()
            except Exception:
                pass
            self.close()
        if wait:
            work()
        else:
            threading.Thread(target=work, daemon=True).start()


class MacPlayer:
    """What the Mac plays through: the sounddevice stream while it works, `afplay` per piece from the first failure
    on, for the rest of the speech (the piece that failed is played again by afplay, so nothing is lost). A failure
    of sounddevice never ends the speech. `kill()` (microphone cut) stops whichever is in progress."""

    def __init__(self, command):
        self.files = FilePlayer(command)
        self.stream = None
        self.streaming = True
        self.cut = False

    def play(self, samples):
        if self.cut:
            return 0
        if self.streaming:
            try:
                if self.stream is None:
                    self.stream = StreamPlayer()
                    if self.cut:  # cut while the stream was opening
                        return 0
                return self.stream.play(samples)
            except Exception:
                self.streaming = False
                self.drop_stream()
                if self.cut:  # the failure was the cut itself: play nothing more
                    return 0
        return self.files.play(samples)

    def drop_stream(self):
        stream, self.stream = self.stream, None
        if stream is not None:
            stream.abort(wait=False)  # not close(): on a device that vanished even close() may never return

    def finish(self):
        stream, self.stream = self.stream, None
        if stream is not None:
            try:
                stream.finish()
            except Exception:
                stream.close()

    def kill(self):
        self.cut = True
        stream = self.stream
        if stream is not None:
            stream.abort(wait=False)  # the microphone cut goes on to the exit: it never waits for the device
        self.files.kill()


def play_files(command, chunks, watch, session=None):
    """Plays each synthesized piece in order (see MacPlayer); returns the last exit code."""
    player = MacPlayer(command)
    watcher = None
    try:
        if watch:
            watcher = watch_microphone(player, session)
        code = 0
        for samples in chunks:
            code = player.play(samples)
        player.finish()
        return code
    finally:
        stop_watching(watcher)
        player.drop_stream()


def play(text):
    """Runs inside the engine's Python: waits its turn in the queue, then synthesizes piece by piece into the
    player's stdin. The turn comes only while the microphone is free (no dictation in progress)."""
    session = current_session()
    try:
        watch = speak_os.SYSTEM == 'mac' or bool(shutil.which('pw-dump'))
        # `speak test` (CLAUDE_SPEAK_TEST) and `speak again` (CLAUDE_SPEAK_AGAIN) are explicit requests: they speak
        # even with the voice off
        if not wait_turn(session, watch) or not (is_on(session) or os.environ.get('CLAUDE_SPEAK_TEST')
                                                 or os.environ.get('CLAUDE_SPEAK_AGAIN')):
            return 0
        from kokoro_onnx import Kokoro
        player = player_command()
        if player is None:
            print('voz: nenhum tocador de áudio (%s)' % speak_os.player_names(), file=sys.stderr)
            return 1
        kokoro = Kokoro(MODEL, VOICES)

        def synth(piece):
            return kokoro.create(piece, voice=voice(), speed=speed(), lang='pt-br')[0]

        if not speak_os.streams():
            return play_files(player, synthesize_ahead(pieces(text), synth), watch, session)
        proc = subprocess.Popen(player, stdin=subprocess.PIPE)
        watcher = watch_microphone(proc, session) if watch else None
        try:
            try:
                for samples in synthesize_ahead(pieces(text), synth):
                    proc.stdin.write(samples.astype('float32').tobytes())
                    proc.stdin.flush()
            finally:
                proc.stdin.close()
            return proc.wait()
        finally:
            stop_watching(watcher)
    finally:
        drop_own_tickets()
        clear_speech(os.getpid())


def venv_works():
    """True when the engine's Python runs. False when it is missing, a broken symlink (lexists, not exists) or does
    not start: after the one-time move of the engine folder the environment may point at places that are gone."""
    if not os.path.lexists(VENV_PY) or not os.path.exists(VENV_PY):
        return False
    try:
        return subprocess.call([VENV_PY, '-c', 'pass'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0
    except OSError:
        return False


def write_progress(**fields):
    """Writes INSTALL_PROGRESS atomically (a temporary file beside it, then os.replace). Cosmetic: errors are ignored."""
    tmp = '%s.tmp-%d' % (INSTALL_PROGRESS, os.getpid())
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(tmp, 'w') as fh:
            json.dump(fields, fh)
        os.replace(tmp, INSTALL_PROGRESS)
    except OSError:
        remove_quietly(tmp)


def remove_quietly(path):
    try:
        os.remove(path)
    except OSError:
        pass


def progress_hook(name, step, steps):
    """The reporthook of urlretrieve: writes the bytes so far, at most every PROGRESS_EVERY seconds."""
    last = [None]

    def hook(blocks, size, total):
        now = time.monotonic()
        if last[0] is not None and now - last[0] < PROGRESS_EVERY:
            return
        last[0] = now
        total = max(total, 0)
        done = blocks * size
        write_progress(fase='baixando', arquivo=name, feito=min(done, total) if total else done, total=total,
                       passo=step, passos=steps)
    return hook


def install():
    uv = shutil.which('uv') or os.path.join(HOME, '.local', 'bin', 'uv')
    if not os.path.exists(uv):
        print('voz: o uv não foi encontrado; instale-o (%s) e rode de novo' % speak_os.notice_uv(), file=sys.stderr)
        return 1
    try:
        return install_steps(uv)
    finally:
        remove_quietly(INSTALL_PROGRESS)
        remove_quietly('%s.tmp-%d' % (INSTALL_PROGRESS, os.getpid()))


def install_steps(uv):
    os.makedirs(DATA, exist_ok=True)
    files = [path for path in (MODEL, VOICES) if not os.path.exists(path)]
    steps = 1 + len(files)  # the dependencies, then each file still missing
    write_progress(fase='dependências', passo=1, passos=steps)
    if not venv_works():
        venv = os.path.join(DATA, '.venv')  # rebuilt alone: the model and voices beside it are not downloaded again
        if os.path.islink(venv):
            os.remove(venv)
        elif os.path.isdir(venv):
            shutil.rmtree(venv)
        subprocess.check_call([uv, 'venv', '--python', '3.12', '-q', venv])
    subprocess.check_call([uv, 'pip', 'install', '-q', '--python', VENV_PY, 'kokoro-onnx'])
    if speak_os.SYSTEM == 'mac':  # a separate step: without it the Mac plays through afplay
        try:
            ok = subprocess.call([uv, 'pip', 'install', '-q', '--python', VENV_PY, 'sounddevice']) == 0
        except OSError:
            ok = False
        if not ok:
            print('voz: sounddevice não instalou; o Mac toca pelo afplay', flush=True)
    for step, path in enumerate(files, 2):
        name = os.path.basename(path)
        print('voz: baixando %s' % name, flush=True)
        write_progress(fase='baixando', arquivo=name, feito=0, total=0, passo=step, passos=steps)
        part = '%s.part-%d' % (path, os.getpid())  # one per process: two installs never share a file
        try:
            urllib.request.urlretrieve(MODEL_URL + name, part, progress_hook(name, step, steps))
            os.replace(part, path)
        finally:
            if os.path.exists(part):
                os.remove(part)
    print('voz: motor instalado em %s' % DATA, flush=True)
    return 0


INSTALL_LOCK = os.path.join(STATE, 'install.lock')  # flock'ed by `speak install` for as long as it runs
INSTALL_PROGRESS = os.path.join(STATE, 'install.progress')  # JSON of the step in course; counts only with INSTALL_LOCK held
PROGRESS_EVERY = 0.5  # seconds between two writes of INSTALL_PROGRESS while downloading
WAIT_POLL = 1.0  # seconds between two looks of an install that waits for another
INSTALL_LOG = os.path.join(STATE, 'install.log')  # where the SessionStart hook sends the background install's output
INSTALL_FAILED = os.path.join(STATE, 'install.failed')  # present after a failed install, holding the plugin version; `autoinstall` reads it
AUTOINSTALL_LOCK = os.path.join(STATE, 'autoinstall.lock')  # held for an instant by `autoinstall`, so two do not start two installs
AUTOINSTALL_WAIT = 3.0  # seconds `autoinstall` waits for the install it started to take INSTALL_LOCK


def plugin_version():
    """The version in .claude-plugin/plugin.json ('' when unreadable)."""
    return speak_paths.plugin_version(os.path.realpath(__file__))


def installing():
    """True while a `speak install` runs (it holds INSTALL_LOCK); the probe releases the lock at once."""
    try:
        probe = open(INSTALL_LOCK, 'a+')
    except OSError:
        return False
    try:
        fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        probe.close()
    return False


def install_progress():
    """The dict in INSTALL_PROGRESS while an install holds INSTALL_LOCK, else None. A file left by an install that
    died is removed (with the lock taken for the moment, so a new install is never caught in the middle)."""
    try:
        probe = open(INSTALL_LOCK, 'a+')
    except OSError:
        return None
    try:
        try:
            fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            try:
                with open(INSTALL_PROGRESS) as fh:
                    data = json.load(fh)
            except (OSError, ValueError):
                return None
            return data if isinstance(data, dict) else None
        remove_quietly(INSTALL_PROGRESS)
        base = os.path.basename(INSTALL_PROGRESS) + '.tmp-'  # temporaries a dead install left beside it
        try:
            for name in os.listdir(STATE):
                if name.startswith(base):
                    remove_quietly(os.path.join(STATE, name))
        except OSError:
            pass
        return None
    finally:
        probe.close()


def progress_percent(progress):
    """0 to 100 for a download of known size, else None."""
    if not progress or progress.get('fase') != 'baixando' or not progress.get('total'):
        return None
    return min(100, round(100 * progress.get('feito', 0) / progress['total']))


def progress_text(progress):
    """The step in words (`baixando o modelo de voz: 253 de 326 MB (78%)`), or None without progress."""
    if not progress:
        return None
    if progress.get('fase') == 'dependências':
        return 'instalando as dependências'
    if progress.get('fase') != 'baixando':
        return None
    what = 'as vozes' if progress.get('arquivo') == os.path.basename(VOICES) else 'o modelo de voz'
    done, total, pct = round(progress.get('feito', 0) / 1e6), round(progress.get('total', 0) / 1e6), progress_percent(progress)
    if pct is None:
        return 'baixando %s: %d MB' % (what, done)
    return 'baixando %s: %d de %d MB (%d%%)' % (what, done, total, pct)


def engine_text():
    """The status line about the engine."""
    if engine_ready():
        return 'instalado em %s' % DATA
    if installing():
        text = progress_text(install_progress())
        return 'sendo instalado em segundo plano%s (registro em %s)' % (': ' + text if text else '', INSTALL_LOG)
    return 'não instalado (rode: speak install)'


def install_marked():
    """install() alone at a time: it waits for a running install (INSTALL_LOCK), printing its progress, then leaves
    INSTALL_FAILED behind when it fails (so the SessionStart hook does not retry by itself) and removes it when it
    works."""
    os.makedirs(STATE, exist_ok=True)
    lock = open(INSTALL_LOCK, 'a+')  # closed (and so unlocked) when the process ends
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print('voz: outra instalação está em andamento; esperando ela terminar', flush=True)
        shown = None
        while True:
            text = progress_text(install_progress())
            if text and text != shown:
                print('voz: %s' % text, flush=True)
                shown = text
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                time.sleep(WAIT_POLL)
    try:
        return install_unlocked()
    finally:
        lock.close()


def install_unlocked():
    failed = False
    try:
        code = install()  # 1 without an exception: no uv, nothing was tried
    except (subprocess.CalledProcessError, OSError) as exc:
        print('voz: a instalação falhou: %s' % exc, file=sys.stderr)
        code, failed = 1, True
    try:
        if failed:
            os.makedirs(STATE, exist_ok=True)
            with open(INSTALL_FAILED, 'w') as fh:
                fh.write(plugin_version())  # the hook retries by itself once per plugin version
        elif not code and os.path.exists(INSTALL_FAILED):
            os.remove(INSTALL_FAILED)
    except OSError:
        pass
    return code


def failed_this_version():
    """True when INSTALL_FAILED holds the current plugin version. An empty one (older versions) or one of another
    version is removed: the install is tried again, once per version."""
    try:
        with open(INSTALL_FAILED) as fh:
            mark = fh.read().strip()
    except OSError:
        return False
    if mark and mark == plugin_version():
        return True
    remove_quietly(INSTALL_FAILED)
    return False


def autoinstall():
    """The one rule for starting the engine install by itself (used by the SessionStart hook and by the module when a
    plugin is turned on in the middle of a session). Starts `speak install` detached (own session, output in
    INSTALL_LOG) unless one runs, the last one failed in this version, the uv is missing or CLAUDE_SPEAK_AUTOINSTALL=0.
    Returns (word, started): word is ready (engine there; also clears INSTALL_FAILED), installing, no-uv, failed or off;
    started is True only when this call started the install (so only it tells the person).
    Safe to call at the same time from several places: AUTOINSTALL_LOCK serializes the probe of INSTALL_LOCK and the
    start, and the call returns only after the child holds INSTALL_LOCK (or AUTOINSTALL_WAIT passed), so the next call
    sees `installing`. If two children still got started, the second waits for INSTALL_LOCK in `install_marked`, so it
    is never two installs at once, and it redoes only what is missing."""
    if engine_ready():
        remove_quietly(INSTALL_FAILED)
        return 'ready', False
    if os.environ.get('CLAUDE_SPEAK_AUTOINSTALL') == '0':
        return 'off', False
    if not os.path.exists(shutil.which('uv') or os.path.join(HOME, '.local', 'bin', 'uv')):
        return 'no-uv', False
    os.makedirs(STATE, exist_ok=True)
    with open(AUTOINSTALL_LOCK, 'a+') as gate:
        fcntl.flock(gate, fcntl.LOCK_EX)
        if engine_ready():  # a call that held the gate before us may have finished the job
            remove_quietly(INSTALL_FAILED)
            return 'ready', False
        if failed_this_version():
            return 'failed', False
        if installing():
            return 'installing', False
        with open(INSTALL_LOG, 'ab') as log:
            child = subprocess.Popen([sys.executable, '-u', '-I', os.path.realpath(__file__), 'install'],
                                     stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
                                     close_fds=True)
        deadline = time.time() + AUTOINSTALL_WAIT
        while time.time() < deadline and child.poll() is None and not installing():
            time.sleep(0.05)
    return 'installing', True


def player_command():
    """The audio player's command line (see speak_os.player), or None."""
    return speak_os.player()


def player_found():
    return player_command() is not None


def missing():
    """What stops speech on this machine: 'engine' (not installed) and/or 'player' (no audio player)."""
    return [name for name, ok in (('engine', engine_ready()), ('player', player_found())) if not ok]


def rule():
    with open(RULE, encoding='utf-8') as fh:
        text = fh.read()
    session = current_session()
    line = RULE_LINE[mode(session)].replace('{size}', SIZE_TEXT[summary_size(session)])
    return text.replace('{line}', line)


def again(which):
    """Speaks the session's last reply again, even with the voice off. which: '' (as it played), 'summary', 'full'."""
    session = current_session()
    last = read_last(session)
    if last is None:
        print('voz: ainda não há uma resposta desta sessão para ouvir de novo', file=sys.stderr)
        return 1
    message, played = last
    how = which or played
    if how == 'summary' and not spoken_line(message):
        how = 'full'
        print('Essa resposta não tinha resumo; vou ler a resposta inteira.')
    said = to_speak(message, how, summary_size(session))
    if not said.strip():
        print('voz: não há nada para ler nessa resposta', file=sys.stderr)
        return 1
    if not engine_ready():
        print('voz: motor %s' % engine_text(), file=sys.stderr)
        return 1
    print('Lendo de novo o resumo da última resposta.' if how == 'summary'
          else 'Lendo de novo a última resposta inteira.')
    return speak_background(said, session, force=True)


def status():
    session = current_session()
    if plugin_version():
        print('versão: %s' % plugin_version())
    here = ' \u00b7 s\u00f3 nesta sess\u00e3o'
    print('voz: %s%s' % ('ligada' if is_on(session) else 'desligada', here if own_field(session, 'voice') else ''))
    print('  geral: %s' % ('desligada' if os.path.exists(OFF_FLAG) else 'ligada'))
    choice = session_choice(session)
    if session:
        print('  esta sessão: %s, modo %s' % ({'muted': 'muda', 'speaking': 'falando'}.get(choice, 'segue a geral'),
                                              session_mode(session) or 'segue o geral'))
    else:
        print('  fora de uma sessão do Claude Code')
    if os.environ.get('CLAUDE_SPEAK') == '0' and (not session or choice == 'muted'):
        print('  desligada só nesta sessão (CLAUDE_SPEAK=0)')
    print('  modo: %s%s' % (mode(session), here if own_field(session, 'mode') else ''))
    print('  tamanho do resumo: %s%s' % (summary_size(session), here if own_field(session, 'size') else ''))
    print('  microfone em uso: %s%s' % (MIC_TEXT[mic(session)], here if own_field(session, 'mic') else ''))
    print('  motor: %s' % engine_text())
    print('  voz: %s, velocidade %s' % (voice(), speed()))
    return 0


def migrate():
    """Moves the former folders to the plugin's data folder, once (speak_paths.migrate_old), then those of the
    former name (`claude-voz`) the same way, when only the old one exists. Config: `desligado` becomes `off`, old
    `fala-*.wav` files are removed, `modo` becomes `mode` (completo -> full, resumo -> summary). The old session
    files (`sessoes`) are dropped. A new folder that already exists wins and the old one is left alone."""
    speak_paths.migrate_old(os.path.dirname(DATA))
    for kind, new in (('engine', DATA), ('config', CONF), ('state', STATE)):
        old = speak_paths.old_folder(kind, 'claude-voz')
        if old and not os.path.exists(new) and speak_paths.move_dir(old, new):
            if new == CONF:
                _translate_config()
            elif new == STATE:
                shutil.rmtree(os.path.join(STATE, 'sessoes'), ignore_errors=True)
                try:
                    os.rename(os.path.join(STATE, 'tudo'), ALL_MARK)
                except OSError:
                    pass
                leftovers = ['fala.pid', 'fala.dono', 'erro.log']
                try:
                    leftovers += [n for n in os.listdir(STATE) if n.startswith('fala-') and n.endswith('.wav')]
                except OSError:
                    pass
                for name in leftovers:
                    try:
                        os.remove(os.path.join(STATE, name))
                    except OSError:
                        pass


    _drop_copied_fields()


def _drop_copied_fields():
    try:
        _drop_copied_fields_once()
    except OSError:
        pass  # unwritable state folder: try again on the next call


def _drop_copied_fields_once():
    """Once: the session files of the old copy-on-all model lose `mode` and `size` equal to the general value
    (`voice` stays: it may be the CLAUDE_SPEAK=0 seed). Marked by STATE/scope so later exceptions are kept."""
    done = os.path.join(STATE, 'scope')
    if os.path.exists(done):
        return
    general = {}  # a missing general file counts as 'full': this describes the old copy model, whose default was full
    for field, path, default in (('mode', MODE_FILE, 'full'), ('size', SIZE_FILE, 'medium')):
        try:
            with open(path) as fh:
                general[field] = fh.read().strip() or default
        except OSError:
            general[field] = default
    for key in os.listdir(SESSIONS) if os.path.isdir(SESSIONS) else ():
        data = read_session(key)
        kept = {k: v for k, v in data.items() if general.get(k) != v}
        if kept != data:
            write_atomic(os.path.join(SESSIONS, key), json.dumps(kept))
    write_atomic(done, '')


def _translate_config():
    try:
        os.rename(os.path.join(CONF, 'desligado'), OFF_FLAG)
    except OSError:
        pass
    old = os.path.join(CONF, 'modo')
    try:
        with open(old) as fh:
            value = {'completo': 'full', 'resumo': 'summary'}.get(fh.read().strip())
        os.remove(old)
        if value:
            with open(MODE_FILE, 'w') as fh:
                fh.write(value + '\n')
    except OSError:
        pass


def silent_reason():
    """Why this session will not speak: `off`, `installing [percent]`, `missing`; None when it will."""
    if not is_on(current_session()):
        return 'off'
    if engine_ready():
        return None
    if installing():
        pct = progress_percent(install_progress())
        return 'installing' if pct is None else 'installing %d' % pct
    return 'missing'


def status_json():
    """The state in force here as one JSON line, for the /speak pane (hooks/register.tsx) to mark what is current."""
    session = current_session()
    now = voice()
    print(json.dumps({'version': plugin_version(), 'on': is_on(session), 'mode': mode(session), 'size': summary_size(session), 'mic': mic(session),
                      'scope': {f: 'session' if own_field(session, g) else 'all'
                                for f, g in (('on', 'voice'), ('mode', 'mode'), ('size', 'size'), ('mic', 'mic'))},
                      'engine': engine_ready(), 'installing': not engine_ready() and installing(),
                      'install': None if engine_ready() else install_progress(),
                      'voice': next((short for short, (full, _) in PT_VOICES.items() if full == now), now)}))
    return 0


def main(argv):
    migrate()
    cmd, rest = (argv[0], argv[1:]) if argv else ('status', [])
    text = ' '.join(rest)
    if cmd in ('on', 'off'):
        if text not in ('', 'all'):
            print('voz: use "speak off", "speak on", "speak off all" ou "speak on all"', file=sys.stderr)
            return 2
        session = current_session()
        if cmd == 'off' and (text or not session):
            os.makedirs(CONF, exist_ok=True)
            open(OFF_FLAG, 'w').close()
            mark_all()
            clear_all_sessions('voice')
            stop_current()
        elif cmd == 'off':
            set_session(session, voice='muted')
            stop_if_mine(session)
        elif text or not session:
            if os.path.exists(OFF_FLAG):
                os.remove(OFF_FLAG)
            mark_all()
            clear_all_sessions('voice')
        else:
            set_session(session, voice='speaking')
        return status()
    if cmd == 'status':
        if text == '--json':
            return status_json()
        return status()
    if cmd == 'stop':
        if text not in ('', 'here'):
            print('voz: use "speak stop"', file=sys.stderr)
            return 2
        if text:
            stop_if_mine(current_session())
        else:
            stop_current()
        return 0
    if cmd == 'mode':
        wanted, _, scope = text.partition(' ')
        if wanted not in MODES or scope not in ('', 'all'):
            print('voz: use "speak mode full" ou "speak mode summary" (com "all" no fim, vale para todas as sessões)',
                  file=sys.stderr)
            return 2
        session = current_session()
        if session and not scope:
            set_session(session, mode=wanted)
        else:
            os.makedirs(CONF, exist_ok=True)
            with open(MODE_FILE, 'w') as fh:
                fh.write(wanted + '\n')
            clear_all_sessions('mode')
        return status()
    if cmd == 'size':
        wanted, _, scope = text.partition(' ')
        if wanted not in SIZES or scope not in ('', 'all'):
            print('voz: use "speak size small", "speak size medium" ou "speak size large" (com "all" no fim, vale para '
                  'todas as sessões)', file=sys.stderr)
            return 2
        session = current_session()
        if session and not scope:
            set_session(session, size=wanted)
        else:
            os.makedirs(CONF, exist_ok=True)
            with open(SIZE_FILE, 'w') as fh:
                fh.write(wanted + '\n')
            clear_all_sessions('size')
        return status()
    if cmd == 'mic':
        wanted, _, scope = text.partition(' ')
        if wanted not in MICS or scope not in ('', 'all'):
            print('voz: use "speak mic wait", "speak mic play" ou "speak mic auto" (com "all" no fim, vale para '
                  'todas as sessões)', file=sys.stderr)
            return 2
        session = current_session()
        if session and not scope:
            set_session(session, mic=wanted, micseen=None)
        else:
            os.makedirs(CONF, exist_ok=True)
            with open(MIC_FILE, 'w') as fh:
                fh.write(wanted + '\n')
            clear_all_sessions('mic', 'micseen')
            try:
                os.remove(MIC_SEEN)
            except OSError:
                pass
        if wanted == 'auto':
            track_mic(session, current_recordings())  # chosen in the middle of the meeting: it counts as seen
        return status()
    if cmd == '_mictick':  # used by hooks/speak-cut.py at each new message: the meeting may have ended
        if mic(current_session()) == 'auto':
            track_mic(current_session(), current_recordings())
        return 0
    if cmd == 'voice':
        if not text:
            for short, (full, kind) in PT_VOICES.items():
                print('%s %s (%s, %s)' % ('*' if full == voice() else ' ', short, full, kind))
            return 0
        full = voice_name(text)
        if not full:
            print('voz: voz desconhecida; use uma de: %s' % ', '.join(PT_VOICES), file=sys.stderr)
            return 2
        os.makedirs(CONF, exist_ok=True)
        with open(VOICE_FILE, 'w') as fh:
            fh.write(full + '\n')
        return status()
    if cmd == 'told':  # the mode last told to the model in this session (a field of the session file)
        session = current_session()
        if text in MODES and session:
            set_session(session, told=text)
        elif not text:
            print(read_session(session).get('told', ''))
        return 0
    if cmd == 'rule':
        try:
            sys.stdout.write(rule())
            if current_session():  # the session starts knowing the mode this rule told
                set_session(current_session(), told=mode(current_session()))
        except OSError:
            return 1
        return 0
    if cmd == 'check':
        gone = missing()
        if gone:
            print(' '.join(gone))
        if 'engine' in gone:
            try:
                with open(INSTALL_LOG, errors='replace') as fh:
                    print(''.join(fh.readlines()[-3:]), end='', file=sys.stderr)
            except OSError:
                pass
        # On stderr: hooks/speak-start.py reads the stdout of `check` as a list of words.
        print('processos acima: %s' % ', '.join('%d %s' % item for item in speak_os.ancestors(os.getppid())),
              file=sys.stderr)
        return 1 if gone else 0
    if cmd == 'silent':
        why = silent_reason()
        if why:
            print(why)
        return 0 if why else 1
    if cmd == 'install':
        return install_marked()
    if cmd == 'autoinstall':
        word, started = autoinstall()
        print(word + (' started' if started else ''))
        return 0
    if cmd == 'say':
        session = current_session()
        if text == '-':
            message, how = sys.stdin.read(), mode(session)
            save_last(session, message, how)  # kept also with the voice off or without the engine
            return speak_background(to_speak(message, how, summary_size(session)), session)
        return speak_background(text, session)
    if cmd == 'update':
        return speak_update.update(os.path.realpath(__file__), plugin_version())
    if cmd == 'again':
        if text not in ('', 'summary', 'full'):
            print('voz: use "speak again", "speak again summary" ou "speak again full"', file=sys.stderr)
            return 2
        return again(text)
    if cmd == 'test':
        if not engine_ready():
            print('voz: motor %s' % engine_text(), file=sys.stderr)
            return 1
        return subprocess.call([VENV_PY, '-I', os.path.realpath(__file__), '_play',
                                text or 'Olá! A voz do Claude Code está funcionando.'],
                               env={**os.environ, 'CLAUDE_SPEAK_TEST': '1'})
    if cmd == '_play':
        return play(text)
    print(__doc__.strip(), file=sys.stderr if cmd not in ('-h', '--help') else sys.stdout)
    return 0 if cmd in ('-h', '--help') else 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
